// [
{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "width": 1342,
    // "height": 26,
    "reload_style_on_change": true,
    "modules-left": [],
    "modules-center": [
        "group/arch",
        "hyprland/workspaces#2",
        "clock",
        "mpris",
        "pulseaudio#speaker",
        "custom/power",
        "power-profiles-daemon",
        "network",
        "custom/notification",
        "tray"
    ],
    "modules-right": [],
    "hyprland/window": {
        "format": " {title}",
        "max-length": 55,
        "icon": false
    },
    "hyprland/workspaces": {
        "format": "{windows}",
        "format-window-separator": "",
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 20,
            "on-click-window": "bash ~/.config/waybar/scripts/focus_window.sh {address} {button}"
        }
    },
        "hyprland/workspaces#2": {
        "format": "{icon}",
        "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
        "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
        "persistent-workspaces": {
            "*": 3
        },
        "cursor": false,
        "format-icons": {
            "active": "󰳭",
            "persistent": "󰨐",
            "empty": "󰨐"
        }
    },
    "memory": {
        "format": "󰍛: {}%"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "mpris": {
        "player": "playerctld",
        "format": "{player_icon} {dynamic}",
        "format-playing": "{player_icon} {dynamic}",
        "format-paused": "{player_icon} {dynamic}",
        "format-stopped": "",
        "dynamic-order": [
            "artist",
            "title"
        ],
        "dynamic-separator": " - ",
        "dynamic-len": 75,
        "tooltip": false,
        "status-icons": {
            "playing": " ",
            "paused": " ",
            "stopped": "Connection Terminated"
        },
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 3
    },
    "clock": {
        "interval": 1,
        "format": "{:%a, %b %d @ %I:%M}", // "format-alt": "   {:%a, %d %b %Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "network": {
        "interval": 1,
        "format-wifi": "",
        //  ({signalStrength}%
        "format-ethernet": "󰈀",
        "format-linked": "󱘖",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "tooltip-format-wifi": "{essid} at {signalStrength}%",
        "tooltip-format-ethernet": "{ifname} {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
            "on-click": "nmgui"
    },
    "bluetooth": {
        "format-on": "󰂯: On",
        "format-off": "󰂯: Off",
        "format-disabled": "󰂲",
        "format-connected": "󰂯: {device_alias} ({device_battery_percentage}%)",
        "tooltip-format": "Bluetooth on",
        "tooltip-format-connected": "{device_enumerate} ({device_battery_percentage}%)",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "{capacity}% ", // Optional: Custom icon when charging
        "format-plugged": "{capacity}% ", // Optional: Custom icon when plugged in
        "tooltip-format": "currently at {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ] // From 0% to 100%
    },
    "pulseaudio#speaker": {
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "format": "{icon} {volume}%",
        "format-muted": "",
        "tooltip-format": "{desc} {volume}%",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "pulseaudio#microphone": {
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pavucontrol",
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "tooltip-format": "Microphone {format_source}"
    },
    ///////////////////////////////// GROUP/XXX ///////////////////////////////////
    "group/arch": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500, // Speed of expansion in ms
            "transition-left-to-right": true // Direction of expansion
        },
        "modules": [
            "custom/arch-icon",
            "memory",
            "bluetooth",
            "battery"
        ]
    },
    "custom/pomo": {
        "exec": "~/.config/waybar/scripts/pomo.sh",
        "on-click": "~/.config/waybar/scripts/pomo.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/pomo.sh stop",
        "on-scroll-up": "~/.config/waybar/scripts/pomo.sh preset-next",
        "on-scroll-down": "~/.config/waybar/scripts/pomo.sh preset-prev",
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "tooltip": false
    },
    "custom/arch-icon": {
        "format": " Arch ", // Use an icon from your font (e.g., Font Awesome)
        "tooltip": false
    },
    "custom/power": {
        "format": "{icon} ",
        "format-icons": [
            " "
        ],
        "on-click": "wlogout",
        "tooltip": false
    },
    "custom/reboot": {
        "format": "{icon} ",
        "format-icons": [
            " "
        ],
        "on-click": "reboot",
        "tooltip-format": "Reboot"
    },
    "custom/lock": {
        "format": "{icon} ",
        "format-icons": [
            " "
        ],
        "on-click": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
        "tooltip-format": "Logout"
    },
    "custom/notification": {
        "return-type": "json",
        "interval": 3,
        "exec": "bash ~/.config/waybar/scripts/notification.sh",
        "on-click": "swaync-client -t -sw",
        "on-click-middle": "swaync-client -C",
        "on-click-right": "swaync-client -S",
        "escape": true,
        "tooltip": true
    },
    "custom/spotify-icon": {
        "format": " ", // Use an icon from your font (e.g., Font Awesome)
        "tooltip": false
    }
    ////////////////////////// START OF BOTTOM BAR BELOW //////////////////////////
}
